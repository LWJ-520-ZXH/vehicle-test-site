    {
      "title": "八、面试高频考点",
      "icon": "🎯",
      "content_blocks": [
        {
          "type": "h3",
          "text": "必会基础"
        },
        {
          "type": "table",
          "headers": [
            "考点",
            "回答"
          ],
          "rows": [
