              "黑屏，仅防盗灯闪烁",
              "休眠电流<5mA"
            ],
            [
              "**ACC**",
              "KL15-R",
              "12V",
              "部分亮(里程/时间)，不启动自检",
              "CAN上仅信息域节点唤醒"
