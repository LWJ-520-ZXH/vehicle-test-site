            "仪表显示",
            "改变项",
            "CAN信号(典型)"
          ],
          "rows": [
            [
              "**ECO**",
              "绿色ECO图标",
              "油门响应迟钝、空调降功率、滑行优先",
              "DriveMode=0"
            ],
            [
              "**Normal**",
              "无特殊图标(默认)",
              "标准调校",
              "DriveMode=1"
            ],
            [
              "**Sport**",
              "红色Sport+氛围灯变红",
              "油门灵敏、转向重、悬架硬、声浪增强",
              "DriveMode=2"
            ],
            [
              "**Individual**",
              "自定义图标",
              "用户可单独调各参数",
              "DriveMode=3"
            ],
            [
              "**Off-road**",
              "越野图标+车身高度",
              "陡坡缓降、差速锁、悬架最高",
              "DriveMode=4"
            ],
            [
              "**Snow/Ice**",
              "雪花图标",
              "油门迟钝、ESP更早介入",
