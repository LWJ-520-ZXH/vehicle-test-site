              "12V",
              "全亮→自检3秒→正常显示",
              "所有ECU上CAN、DTC自检"
            ],
            [
              "**START**",
              "KL50",
              "12V",
              "Ready灯亮，转速指针上升",
              "启动瞬间供电电压（KL30）跌落不能导致仪表复位"
            ],
            [
              "**CRANK**",
              "KL50脉冲",
              "12V→可能跌至8V",
              "仪表背光可能闪烁",
              "低压启动需叠加测试"
