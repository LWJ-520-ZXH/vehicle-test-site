            ],
            [
              "**路径规划**",
              "重算时间<3s、途经点顺序正确、避开选项生效"
            ],
            [
              "**TTS播报**",
              "时机(转弯前300m+100m)、与多媒体/通话的打断恢复"
            ],
            [
              "**在线/离线**",
              "切换不丢路线、离线搜索覆盖度、地图版本一致性"
