              "油门踏板信号丢失",
              "CANoe屏蔽该报文",
              "VCU接管，限制功率输出"
            ],
            [
              "电机过温",
              "仿真传感器超阈值",
              "降功率，亮报警灯"
            ],
            [
              "CAN总线断线",
              "物理拔线",
              "报通信丢失DTC，强制跛行"
            ],
            [
              "相电流异常",
              "注入错误信号",
              "MCU切断输出，报U相故障"
